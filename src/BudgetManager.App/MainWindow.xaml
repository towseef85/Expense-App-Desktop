<Window
    x:Class="BudgetManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Budget Manager">
    <NavigationView
        x:Name="PrimaryNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard" />
            <NavigationViewItem Content="Transactions" Tag="Transactions" />
            <NavigationViewItem Content="Accounts" Tag="Accounts" />
            <NavigationViewItem Content="Budgets" Tag="Budgets" />
            <NavigationViewItem Content="Recurring" Tag="Recurring" />
            <NavigationViewItem Content="Rent funds" Tag="RentFunds" />
            <NavigationViewItem Content="Imports" Tag="Imports" />
            <NavigationViewItem Content="Reconciliation" Tag="Reconciliation" />
            <NavigationViewItem Content="Reports" Tag="Reports" />
        </NavigationView.MenuItems>
        <Grid Padding="32">
            <StackPanel Spacing="12">
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard" />
                <TextBlock
                    MaxWidth="680"
                    HorizontalAlignment="Left"
                    Text="This foundation shell establishes navigation only. Financial behavior will be added in its approved milestone."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
